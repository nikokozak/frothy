{
  "name": "Seeed Studio XIAO RP2040",
  "chip": "rp2040",
  "target": "arduino-rp2040",
  "profile": "rp2040_plain",
  "console": {
    "kind": "usb_cdc"
  },
  "target_options": {
    "ARDUINO_FQBN": "rp2040:rp2040:seeed_xiao_rp2040",
    "ARDUINO_OPTIONS": "freq=133,opt=Small,usbstack=picosdk"
  },
  "flash_bytes": 2097152,
  "bootsel": "Hold BOOT, tap RESET, then release BOOT to make the RPI-RP2 drive appear.",
  "cores": 2,
  "peripherals": ["gpio", "adc", "uart", "pwm", "i2c", "i2s"],
  "pins": {
    "$led_builtin": 17,
    "$led_active_level": 0,
    "$a0": 26,
    "$sda": 6,
    "$scl": 7
  }
}
