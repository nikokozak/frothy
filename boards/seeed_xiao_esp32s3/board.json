{
  "name": "Seeed Studio XIAO ESP32S3",
  "chip": "esp32s3",
  "target": "esp-idf",
  "profile": "esp32_plain",
  "console": {
    "kind": "usb_serial_jtag"
  },
  "target_options": {
    "ESP_IDF_TARGET": "esp32s3"
  },
  "cores": 2,
  "peripherals": ["gpio", "adc", "uart", "pwm", "i2c", "i2s", "net", "ble"],
  "pins": {
    "$led_builtin": 21,
    "$led_active_level": 0,
    "$boot_button": 0,
    "$a0": 1,
    "$sda": 5,
    "$scl": 6,
    "uart_tx": 43,
    "uart_rx": 44,
    "uart_baud": 115200
  }
}
