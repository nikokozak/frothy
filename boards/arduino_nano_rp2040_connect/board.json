{
  "name": "Arduino Nano RP2040 Connect",
  "chip": "rp2040",
  "target": "arduino-rp2040",
  "profile": "rp2040_nina",
  "console": {
    "kind": "usb_cdc"
  },
  "target_options": {
    "ARDUINO_FQBN": "rp2040:rp2040:arduino_nano_connect",
    "ARDUINO_OPTIONS": "freq=133,opt=Small,usbstack=picosdk",
    "HAS_NINA": 1
  },
  "flash_bytes": 16777216,
  "bootsel": "With USB connected, connect REC to GND, press RESET, then remove the jumper when the RPI-RP2 drive appears.",
  "cores": 2,
  "peripherals": ["gpio", "adc", "uart", "pwm", "i2c", "i2s", "net", "ble"],
  "pins": {
    "$led_builtin": 6,
    "$led_active_level": 1,
    "$a0": 26,
    "$sda": 12,
    "$scl": 13
  }
}
