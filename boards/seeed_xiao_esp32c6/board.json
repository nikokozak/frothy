{
  "name": "Seeed Studio XIAO ESP32C6",
  "chip": "esp32c6",
  "target": "esp-idf",
  "profile": "esp32_plain",
  "console": {
    "kind": "usb_serial_jtag"
  },
  "target_options": {
    "ESP_IDF_TARGET": "esp32c6"
  },
  "cores": 1,
  "peripherals": ["gpio", "adc", "uart", "pwm", "i2c", "i2s", "net", "ble"],
  "pins": {
    "$led_builtin": 15,
    "$led_active_level": 0,
    "$boot_button": 9,
    "$a0": 0,
    "$sda": 22,
    "$scl": 23,
    "uart_tx": 16,
    "uart_rx": 17,
    "uart_baud": 115200
  }
}
