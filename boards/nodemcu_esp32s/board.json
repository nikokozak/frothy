{
  "name": "NodeMCU ESP-32S",
  "chip": "esp32",
  "target": "esp-idf",
  "profile": "esp32_plain",
  "console": { "kind": "uart", "port": 0 },
  "target_options": { "ESP_IDF_TARGET": "esp32" },
  "cores": 2,
  "peripherals": ["gpio", "adc", "uart", "pwm", "i2c", "i2s", "net", "ble"],
  "pins": {
    "$boot_button": 0,
    "$a0": 34,
    "$sda": 21,
    "$scl": 22,
    "uart_tx": 1,
    "uart_rx": 3,
    "uart_baud": 115200
  }
}
